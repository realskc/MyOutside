# MyOutside 的对外入口（D-0089）：自动 HTTPS；把请求转给本机的 MyOutside 服务端（docs/future/web-version.md §5）。

myoutside.org {
	encode zstd gzip
	header -Server

	# 独立 CodexGateway 项目的入口；保留此规则，避免 MyOutside 部署时覆盖它。
	handle_path /codex-gateway/* {
		request_body {
			max_size 8MB
		}
		reverse_proxy 127.0.0.1:8788 {
			flush_interval -1
		}
	}
	# MyOutside 登录请求仍限制为 4 KB（D-0093）。
	handle {
		request_body {
			max_size 4KB
		}
		reverse_proxy 127.0.0.1:8787
	}
}

# www 跳到主域名
www.myoutside.org {
	redir https://myoutside.org{uri} permanent
}
